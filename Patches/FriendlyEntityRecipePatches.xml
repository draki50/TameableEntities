<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Allow anesthetize on friendly entities -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/RecipeDef[defName="Anesthetize"]</xpath>
		<value>
			<recipeUsers>
				<li>Sightstealer</li>
				<li>Chimera</li>
				<li>Devourer</li>
				<li>Gorehulk</li>
				<li>Noctol</li>
				<li>Bulbfreak</li>
				<li>Dreadmeld</li>
				<li>Fingerspike</li>
				<li>Trispike</li>
				<li>Toughspike</li>
			</recipeUsers>
		</value>
	</Operation>

	<!-- Allow euthanize on friendly entities -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/RecipeDef[defName="Euthanize"]</xpath>
		<value>
			<recipeUsers>
				<li>Sightstealer</li>
				<li>Chimera</li>
				<li>Devourer</li>
				<li>Gorehulk</li>
				<li>Noctol</li>
				<li>Bulbfreak</li>
				<li>Dreadmeld</li>
				<li>Fingerspike</li>
				<li>Trispike</li>
				<li>Toughspike</li>
			</recipeUsers>
		</value>
	</Operation>

</Patch>